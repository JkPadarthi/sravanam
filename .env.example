# Sravanam — copy to .env and fill
#   cp .env.example .env
# DB password — any strong password. e.g. openssl rand -hex 24
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT signing secret — e.g. openssl rand -hex 48
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Optional override (default 7 days)
JWT_EXPIRE_MINUTES=10080